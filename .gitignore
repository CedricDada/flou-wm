reports/*
!reports/README.md
# Répétition générale : résultats SIMULÉS (scripts/dry_run.py), à ne jamais committer.
data_dryrun/
runs_dryrun/
*.npz
*.pt
*.ckpt

# Copie locale de l'état Kaggle (téléchargement) : le Dataset flou-wm-etat fait foi.
flou_etat/
flou-etat/

# Résultats d'une session Kaggle, transmis pour lecture : ils vivent sur Kaggle, jamais dans le dépôt.
log.txt
notebooks/flou_kaggle-result.ipynb
docs/animations
# Identifiants (Azure Speech, etc.) : jamais dans git.
.env

# Résultats de la campagne : copie légère versionnée (sans les poids), pour refaire le rapport sans GPU.
!resultats/runs/*/eval_arrays.npz

# Documents de travail, notebooks et liste de tâches : gardés en local, hors du dépôt public.
docs/
notebooks/
